<%# partials/_settings-modal.ejs — Modal pengaturan akun (DaisyUI dialog) %>
<%# Cara pakai: window.openSettings(accountId, accountName) %>

<dialog id="settings-modal" class="modal">
  <div class="modal-box w-full max-w-lg">
    <button
      type="button"
      class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3"
      id="close-modal-btn">✕</button>

    <h3 class="font-bold text-lg mb-1">Pengaturan Akun</h3>
    <p class="text-sm text-base-content/50 mb-5">
      <span id="modal-account-name" class="font-medium text-base-content"></span>
    </p>

    <form id="settings-form" method="POST" class="space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <%# Webhook URL %>
      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text font-medium">Webhook URL</span>
        </label>
        <input
          type="url"
          id="webhookUrl"
          name="webhookUrl"
          placeholder="https://n8n.example.com/webhook/..."
          class="input input-bordered w-full" />
        <label class="label pt-1">
          <span class="label-text-alt text-base-content/40">URL untuk meneruskan pesan masuk ke n8n, Make, dll.</span>
        </label>
      </div>

      <%# API Key %>
      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text font-medium">API Key</span>
        </label>
        <div class="join w-full">
          <input
            type="text"
            id="apiKey"
            name="apiKey"
            placeholder="APIKEY_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
            class="input input-bordered join-item flex-1 font-mono text-sm" />
          <button
            type="button"
            id="generate-api-key-btn"
            class="btn btn-outline join-item">
            Generate
          </button>
        </div>
        <label class="label pt-1">
          <span class="label-text-alt text-base-content/40">Kunci untuk autentikasi request API dari sistem eksternal.</span>
        </label>
      </div>

      <%# Media settings — hanya tampil jika allowMedia aktif %>
      <div id="media-settings-container" class="space-y-4 hidden">
        <div class="divider text-xs text-base-content/40">Pengaturan Media</div>

        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text font-medium">Max Upload Size (MB)</span>
          </label>
          <input
            type="number"
            id="maxFileSize"
            name="maxFileSize"
            min="1"
            max="100"
            class="input input-bordered w-32" />
        </div>

        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text font-medium">Tipe File Diizinkan</span>
          </label>
          <div id="mimeTypeOptions" class="grid grid-cols-2 gap-2 text-sm">
            <span class="text-base-content/40 text-xs">Memuat daftar tipe file...</span>
          </div>
          <input type="hidden" name="allowedMimeTypes" id="allowedMimeTypes">
        </div>
      </div>

      <div class="modal-action mt-6 pt-4 border-t border-base-300">
        <button type="button" class="btn btn-ghost" id="cancel-modal-btn">Batal</button>
        <button type="submit" class="btn btn-primary">Simpan Pengaturan</button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>