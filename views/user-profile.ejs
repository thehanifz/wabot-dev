<!DOCTYPE html>
<html lang="id" data-theme="wabot">
<head><%- include('partials/core/head', { title: 'Profile' }) %></head>
<body class="bg-base-200 min-h-screen">
<div class="drawer lg:drawer-open">
  <input id="app-drawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content flex flex-col min-h-screen">
    <%- include('partials/nav/topbar-app') %>
    <main class="flex-1 max-w-3xl mx-auto w-full px-4 sm:px-6 py-6">
      <%- include('partials/core/flash-alert') %>
      <%- include('partials/core/page-header', {
        pageTitle: 'Profile',
        pageSubtitle: 'Informasi akun Google Anda.'
      }) %>

      <%# Info card — data dari Google, read-only %>
      <div class="card bg-base-100 border border-base-300/70 shadow-sm mb-5">
        <div class="card-body p-5">
          <div class="flex items-center gap-4">
            <div class="avatar placeholder">
              <div class="bg-brand-100 text-brand-700 rounded-full w-14">
                <span class="text-xl font-bold">
                  <%= userData.name ? userData.name.charAt(0).toUpperCase() : userData.email.charAt(0).toUpperCase() %>
                </span>
              </div>
            </div>
            <div>
              <p class="font-semibold text-base-content text-lg"><%= userData.name || '—' %></p>
              <p class="text-sm text-base-content/50"><%= userData.email %></p>
              <div class="flex items-center gap-2 mt-1">
                <span class="badge badge-sm <%= userData.role === 'admin' ? 'badge-primary' : 'badge-ghost' %>">
                  <%= userData.role %>
                </span>
                <span class="text-xs text-base-content/40">
                  Bergabung <%= new Date(userData.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# Google account notice %>
      <div class="alert alert-info shadow-sm mb-5">
        <i data-lucide="info" class="w-5 h-5 shrink-0"></i>
        <div>
          <p class="font-medium text-sm">Akun terhubung via Google</p>
          <p class="text-xs opacity-80 mt-0.5">
            Nama, email, dan kata sandi dikelola langsung oleh Google.
            Untuk mengubah informasi tersebut, kunjungi
            <a href="https://myaccount.google.com" target="_blank" rel="noopener noreferrer"
               class="underline font-medium">myaccount.google.com</a>.
          </p>
        </div>
      </div>

      <%# Stats card %>
      <div class="card bg-base-100 border border-base-300/70 shadow-sm">
        <div class="card-body p-5">
          <h3 class="font-semibold text-base-content mb-4">Informasi Akun</h3>
          <dl class="space-y-3">
            <div class="flex items-center justify-between py-2 border-b border-base-200">
              <dt class="text-sm text-base-content/50">Nama</dt>
              <dd class="text-sm font-medium text-base-content"><%= userData.name || '—' %></dd>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-base-200">
              <dt class="text-sm text-base-content/50">Email</dt>
              <dd class="text-sm font-medium text-base-content"><%= userData.email %></dd>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-base-200">
              <dt class="text-sm text-base-content/50">Role</dt>
              <dd>
                <span class="badge badge-sm <%= userData.role === 'admin' ? 'badge-primary' : 'badge-ghost' %>">
                  <%= userData.role %>
                </span>
              </dd>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-base-200">
              <dt class="text-sm text-base-content/50">Batas Device</dt>
              <dd class="text-sm font-medium text-base-content"><%= userData.sessionLimit %></dd>
            </div>
            <div class="flex items-center justify-between py-2">
              <dt class="text-sm text-base-content/50">Bergabung</dt>
              <dd class="text-sm text-base-content/70">
                <%= new Date(userData.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </main>
  </div>
  <div class="drawer-side z-40">
    <label for="app-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
    <%- include('partials/nav/sidebar-user') %>
  </div>
</div>
<%- include('partials/core/scripts', { loadSocketIO: false }) %>
</body>
</html>
